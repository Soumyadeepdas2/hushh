# ============================================================
# hushh — Supabase configuration
# ============================================================
#
# 1. Copy this file to .env
# 2. Fill in the values from your Supabase project:
#    Dashboard -> Project Settings -> API
#      - Project URL        -> VITE_SUPABASE_URL
#      - anon / public key  -> VITE_SUPABASE_ANON_KEY
#
# The anon (publishable) key is safe to ship in the frontend.
#
# NEVER put the service_role key in this file or anywhere in the
# frontend. The service_role key exists ONLY as a secret inside the
# recover-password Edge Function.
# ============================================================

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ============================================================
# CAPTCHA (bot protection at account creation) — OPTIONAL
# ============================================================
# Public hCaptcha site key. When set, a CAPTCHA widget is shown on the
# registration form and the token is verified by Supabase Auth.
# When empty/absent, registration works without CAPTCHA (local dev).
#
# The matching hCaptcha SECRET key must be configured in the Supabase
# Dashboard: Authentication -> Security -> Bot and Abuse Protection ->
# CAPTCHA (provider: hCaptcha). The secret NEVER goes in this file.
# ============================================================

VITE_CAPTCHA_SITE_KEY=
